
# SugamGov Database Configuration
# Replace YOUR_PASSWORD with your local PostgreSQL postgres user password
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sugamgov

# Google Gemini API Key for Embeddings and RAG
GEMINI_API_KEY=your_gemini_api_key_here

# Generation Model (defaults to gemini-3.5-flash-lite)
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# FastAPI Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
